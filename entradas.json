---
layout: null
---
[{% for post in site.posts %}
  {
    "titulo": {{ post.title | jsonify }},
    "fecha": "{{ post.date | date: '%Y-%m-%d' }}",
    "slug": {{ post.slug | jsonify }},
    "url": {{ post.url | jsonify }},
    "categoria": {{ post.categoria | default: "Ensayo" | jsonify }},
    "resumen": {{ post.resumen | default: post.excerpt | strip_html | strip_newlines | truncate: 240 | jsonify }},
    "imagen": {{ post.imagen | jsonify }},
    "archivo": {{ post.archivo | jsonify }},
    "enlace": {{ post.enlace | jsonify }},
    "contenido": {{ post.content | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}
]
